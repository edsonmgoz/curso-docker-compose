---
import { sesiones, fechaCorta, rutaSitio } from '../data/sesiones';
---

<ol class="ruta not-content" aria-label="Sesiones del programa">
	{
		sesiones.map((sesion) => (
			<li class:list={['ruta__sesion', { 'ruta__sesion--disponible': sesion.estado === 'disponible' }]}>
				<a href={rutaSitio(`sesiones/${sesion.slug}/`)}>
					<span class="ruta__cabecera">
						<span class="ruta__numero">{String(sesion.numero).padStart(2, '0')}</span>
						<span class="ruta__fecha">{fechaCorta(sesion)}</span>
					</span>
					<span class="ruta__titulo">{sesion.titulo}</span>
					<span class="ruta__estado">
						{sesion.estado === 'disponible' ? 'Material disponible' : 'Próximamente'}
					</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.ruta {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
		gap: 0.875rem;
	}
	.ruta__sesion a {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		height: 100%;
		padding: 1rem 1.125rem;
		border: 1px solid var(--curso-borde);
		border-left: 3px solid var(--sl-color-gray-5);
		border-radius: 0.625rem;
		background: var(--sl-color-black);
		box-shadow: var(--curso-sombra);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.ruta__sesion--disponible a {
		border-left-color: var(--sl-color-accent);
	}
	.ruta__sesion a:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-1px);
	}
	.ruta__cabecera {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}
	.ruta__numero {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xl);
		font-weight: 600;
		color: var(--sl-color-accent);
	}
	.ruta__fecha {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ruta__titulo {
		font-weight: 600;
		line-height: 1.35;
		color: var(--sl-color-white);
	}
	.ruta__estado {
		margin-top: auto;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ruta__sesion--disponible .ruta__estado {
		color: var(--curso-exito);
		font-weight: 600;
	}
	@media (prefers-reduced-motion: reduce) {
		.ruta__sesion a {
			transition: none;
		}
		.ruta__sesion a:hover {
			transform: none;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.ruta__sesion {
				animation-name: ruta-aparecer;
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: view();
				animation-range: entry 0% entry 70%;
			}
		}
	}
	@keyframes ruta-aparecer {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
</style>
